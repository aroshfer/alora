# Copy this file to .env and fill in real values before running.

PORT=4000

# Origin of the Vite frontend — must match exactly for cookies to work.
CLIENT_ORIGIN=http://localhost:5173

# Used to sign session JWTs. Generate a real random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# NEVER commit a real secret to version control.
JWT_SECRET=replace-this-with-a-long-random-string

# Set to "true" only when serving over HTTPS in production —
# it makes the session cookie require a secure connection.
COOKIE_SECURE=false
